{
  "data_dir": "./data/Histopathology",
  "output_dir": "./outputs",
  "checkpoint_dir": "./checkpoints",
  "seed": 42,
  "image_size": 64,
  "in_channels": 3,
  "batch_size": 32,
  "num_workers": 0,
  "cache_in_ram": true,
  "base_channels": 64,
  "channel_mults": [
    1,
    2,
    4,
    4
  ],
  "num_res_blocks": 2,
  "attn_resolutions": [
    16,
    8
  ],
  "dropout": 0.05,
  "num_heads": 4,
  "scale_shift_norm": true,
  "timesteps": 1000,
  "beta_schedule": "cosine",
  "beta_start": 0.0001,
  "beta_end": 0.02,
  "min_snr_gamma": 5.0,
  "dynamic_threshold": true,
  "dynamic_threshold_p": 0.995,
  "epochs": 400,
  "lr": 0.0002,
  "min_lr": 2e-05,
  "warmup_steps": 1000,
  "weight_decay": 0.0001,
  "grad_clip": 1.0,
  "ema_decay": 0.9995,
  "use_amp": true,
  "log_interval": 10,
  "sample_interval": 25,
  "preview_use_ddim": true,
  "eval_batch_size": 64,
  "eval_num_samples": 2048,
  "eval_use_ddim": false,
  "ddim_steps": 100,
  "ddim_eta": 0.0
}